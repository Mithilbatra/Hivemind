# `make setup` copies this to .env with a random SECRET_KEY, admin password, Postgres password and your user id.
# Docker Compose reads .env. If you copy it by hand, set SECRET_KEY yourself (a placeholder makes the API
# pick a random one at each start, which signs everyone out on restart).

SECRET_KEY=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
POSTGRES_PASSWORD=orchestrator

# --- Infrastructure (hostnames are the compose service names) ---
DATABASE_URL=postgresql+psycopg://orchestrator:orchestrator@db:5432/orchestrator
REDIS_URL=redis://redis:6379/0

# --- Agent ---
# mock: scripted fake agent so the whole pipeline runs without credentials (demo / CI).
# cli:  run AGENT_COMMAND for every session; the prompt is written to its stdin.
AGENT_MODE=mock
# With mock, make the first writer attempt fail validation so you can watch the retry loop.
MOCK_FAIL_FIRST=true
# Seconds the mock agent pauses between output lines, so you can watch agents work in the hub.
MOCK_STEP_S=3
# Your agent CLI in headless mode: it must read the prompt on stdin; stream-json output is parsed if present.
AGENT_COMMAND=
# Append --allowedTools/--disallowedTools from each agent role's policy to AGENT_COMMAND.
AGENT_TOOL_FLAGS=true

# --- Repository access (fail closed: empty means no repo can be used) ---
# Comma-separated paths INSIDE the containers. REPOS_DIR on the host is mounted at /repos.
ALLOWED_REPO_ROOTS=/repos
REPOS_DIR=./samples/repos
WORKTREES_DIR=/data/worktrees
DATA_DIR=/data/state

# --- Limits ---
SESSION_TIMEOUT_S=900
VALIDATION_TIMEOUT_S=600
MAX_RETRIES=2
RETRY_BACKOFF_S=2
# How many tasks (and so agents) can run at the same time.
WORKER_CONCURRENCY=4
MAX_PROMPT_CHARS=24000

# --- Git identity used for commits made after approval ---
GIT_AUTHOR_NAME=Hivemind
GIT_AUTHOR_EMAIL=hivemind@localhost

# --- Ports (bound to 127.0.0.1) / host user that owns the repos (`make setup` fills in yours) ---
API_PORT=8000
WEB_PORT=47213
HOST_UID=1000
HOST_GID=1000
